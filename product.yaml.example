# Copy this to tracks/<track-name>/<short-product-name>.yaml.
# Prices are displayed pre-tax, in the currency shown by the retailer (CAD expected).
name: Samsung Odyssey G80SD
desirability: 9.0    # Optional preference score, 0–10; higher sorts first.
target_price: 999.99 # Optional; target is met at or below this value.
notes:               # Optional free-form buying notes, shown in the report.
  - "Excellent OLED panel; watch for burn-in warranty coverage."
  - "Preferred if it reaches the target price."
refresh_after: 2h    # Successful fetches: optional; defaults to 2h.
retry_after: 1h      # Failed fetches: optional; defaults to 1h.
retailers:
  - name: Amazon
    # fetcher: browser  # Optional; requires Playwright + Chromium (see README).
    url: https://www.amazon.ca/dp/EXAMPLE
  - name: Canada Computers
    url: https://www.canadacomputers.com/product_info.php?item_id=EXAMPLE
    refresh_after: 1h # A retailer URL may override the successful-fetch delay.
    # retry_after: 30m # A retailer URL may also override the failed-fetch delay.
    # price_selector: ".product-price" # Optional CSS selector override.
  - name: Newegg Canada
    url: https://www.newegg.ca/p/EXAMPLE
    seller: Example Marketplace Seller # Optional: the actual seller, if different from the retailer.
    seller_type: third_party # Optional: first_party or third_party; third-party listings show [3P].
    fetcher: manual # Import HTML saved from your normal browser; never fetch automatically.
    # For an isolated Playwright browser instead:
    # fetcher: interactive
    # browser_engine: firefox # chromium (default) or firefox.
    refresh_after: 24h
  - name: Memory Express
    url: https://www.memoryexpress.com/Products/MXEXAMPLE
